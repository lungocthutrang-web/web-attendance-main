COMPOSE_PROJECT_NAME=web-attendance

# ===== Ports =====
PORT=5050
BACKEND_PORT=5050
MYSQL_PORT=3307

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=attendance_db
MYSQL_USER=attendance_user
MYSQL_PASSWORD=attendance_pass

# ===== Backend DB connect (trong compose) =====
DB_HOST=mysql
DB_PORT=3306
DB_USER=attendance_user
DB_PASSWORD=attendance_pass
DB_NAME=attendance_db

# ===== Face match threshold (cosine similarity) =====
FACE_MATCH_THRESHOLD=0.38

# ===== Flask BASE URL (service name trong compose) =====
# ⚠️ PHẢI là base, KHÔNG có /embed
FLASK_URL=http://flask:5001
FLASK_PORT=5001

# (Khuyến nghị) email alerts
# EMAIL_USER=attendancemaneger@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
